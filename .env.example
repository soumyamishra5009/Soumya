# Cognix - Environment Variables

# =================================
# APP CONFIG
# =================================
NEXT_PUBLIC_APP_NAME=Cognix
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_URL=http://localhost:8000
# The browser-facing API URL. Set this in Vercel to your deployed API, e.g.
# NEXT_PUBLIC_API_URL=https://syncforge-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000
ENVIRONMENT=development

# =================================
# DATABASE (PostgreSQL + pgvector)
# =================================
# Zero-setup local dev uses SQLite. For production, use Postgres + pgvector:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/syncforge
DATABASE_URL=sqlite:///./syncforge.db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=syncforge
POSTGRES_PORT=5432

# =================================
# REDIS (Celery Queue)
# =================================
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# =================================
# AUTH.JS (NextAuth)
# =================================
AUTH_SECRET=your-super-secret-auth-key-change-this-in-prod
AUTH_URL=http://localhost:3000

# OAuth Providers
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# =================================
# GITHUB INTEGRATION
# =================================
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Personal access token used to push pull requests. Optional: without it the
# offline "local git" provider is used and everything still works.
GITHUB_TOKEN=your-personal-access-token-for-dev
# Override for GitHub Enterprise. Defaults to https://api.github.com
GITHUB_API_URL=https://api.github.com

# =================================
# LLM CONFIG (cloud-first: Gemini -> OpenRouter -> Ollama)
# =================================
# Provider ladder — the first one that is configured wins. Cloud providers need
# nothing installed locally, which is what live deploys (Vercel + Render) use.
LLM_PROVIDER_ORDER=gemini,openrouter,ollama

# --- 1) Google Gemini (cloud, free tier, OpenAI-compatible) ---------------
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBED_MODEL=text-embedding-004

# --- 2) OpenRouter (cloud fallback, free models available) ----------------
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# --- 3) Ollama (fully local/offline last resort; no key needed) -----------
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_CHAT_MODEL=llama3.1:8b
DEFAULT_SUMMARY_MODEL=llama3.1:8b
DEFAULT_FAST_MODEL=llama3.1:8b
EMBEDDING_MODEL=nomic-embed-text

# Offline extractive fallback when no LLM is reachable
ALLOW_EXTRACTIVE_FALLBACK=true

# Model Selection Strategy
ENABLE_MODEL_ROUTING=true
CODE_MODEL=qwen2.5-coder:7b
SUMMARY_MODEL=llama3.1:8b
AGENT_MODEL=deepseek-coder:6.7b

# =================================
# SPEECH TO TEXT (STT)
# =================================
# Option 1: faster-whisper (local, free) — for running the API on your machine
STT_ENGINE=whisper_local
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Option 2: Gemini audio transcription (cloud) — same GEMINI_API_KEY as the LLM,
# no model download. Applied automatically on Vercel (STT_ENGINE=gemini).
# GEMINI_STT_MODEL=gemini-2.0-flash

# Option 3: Groq Whisper (cloud, free tier) — an alternative cloud engine.
# STT_ENGINE=groq_whisper
GROQ_API_KEY=gsk_your-groq-api-key
GROQ_WHISPER_MODEL=whisper-large-v3

# =================================
# VECTOR SEARCH (pgvector)
# =================================
VECTOR_DIMENSION=768
SIMILARITY_THRESHOLD=0.7

# =================================
# CODE EXECUTION SANDBOX (Phase 5: test runs)
# =================================
# "local" runs the workspace's tests as a subprocess inside the Dev Studio
# sandbox with a hard timeout — works offline, needs no Docker. A bundled
# dependency-free runner is used when pytest is not importable. On serverless
# hosts (Vercel) the DB-backed sandbox is materialised into a temp dir first.
CODE_EXECUTOR=local
JUDGE0_BASE_URL=http://localhost:2358
JUDGE0_API_KEY=your-judge0-api-key

# Option 2: E2B (cloud, has free credits)
# CODE_EXECUTOR=e2b
E2B_API_KEY=e2b_your-e2b-api-key

# Option 3: Piston remote executor. The public instance requires an
# authorization token since Feb 2026, so only set this if you have one.
# CODE_EXECUTOR=piston
PISTON_API_KEY=
PISTON_BASE_URL=https://emkc.org/api/v2/piston

# Execution Limits
EXEC_TIMEOUT_SECONDS=30
EXEC_MAX_MEMORY_MB=512
EXEC_MAX_CPU_PERCENT=50
EXEC_MAX_OUTPUT_CHARS=20000
EXEC_PREFER_PYTEST=true

# =================================
# PROJECT MEMORY (Phase 5: workspace RAG)
# =================================
# Deterministic offline embeddings (hashing trick) so memory search works with
# no embedding server; a real model's vectors are stored at their own dim.
MEMORY_EMBED_DIM=256
MEMORY_CHUNK_CHARS=1200
MEMORY_CHUNK_OVERLAP=150
MEMORY_TOP_K=8
MEMORY_MAX_CHUNKS=5000
MEMORY_INDEX_MAX_FILES=200
MEMORY_MIN_SCORE=0.05

# =================================
# FILE STORAGE
# =================================
# Option 1: Local Storage
STORAGE_TYPE=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=100

# Option 2: Supabase Storage
# STORAGE_TYPE=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=syncforge-files

# =================================
# DEV STUDIO (Phase 3)
# =================================
# Per-workspace sandbox for the AI Dev Studio. Each workspace gets its own
# directory under this root and can never read or write outside it.
DEVSTUDIO_ROOT=./devstudio

# Storage backend for the sandbox tree: "disk" (default, local dirs above) or
# "db" (WorkspaceFile rows in the database — used on Vercel/serverless where
# there is no persistent disk; applied automatically when VERCEL=1).
DEVSTUDIO_BACKEND=disk

DEVSTUDIO_MAX_FILE_KB=512
DEVSTUDIO_MAX_FILES=2000
DEVSTUDIO_MAX_DEPTH=8
# Characters of the open file included as AI chat context.
DEVSTUDIO_CONTEXT_CHARS=12000

# =================================
# SHIP IT (Phase 4)
# =================================
# The Meeting→Code agent. How many files it may surface as "affected" and how
# much file content it feeds the planner.
AGENT_MAX_FILES=8
AGENT_CONTEXT_CHARS=20000

# =================================
# CELERY WORKER
# =================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_TIME_LIMIT=3600
CELERY_TASK_SOFT_TIME_LIMIT=3000

# =================================
# SECURITY & RATE LIMITING
# =================================
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_PER_MINUTE=60
MAX_TRANSCRIPT_CHARS=500000
REQUIRE_CONSENT_FOR_RECORDINGS=true

# =================================
# LOGGING & MONITORING
# =================================
LOG_LEVEL=info
ENABLE_DEBUG=false

# =================================
# DEVELOPMENT
# =================================
NEXT_TELEMETRY_DISABLED=1
PYTHONUNBUFFERED=1

# SyncForge AI - Environment Variables

# =================================
# APP CONFIG
# =================================
NEXT_PUBLIC_APP_NAME=SyncForge AI
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_URL=http://localhost:8000
ENVIRONMENT=development

# =================================
# DATABASE (PostgreSQL + pgvector)
# =================================
# Zero-setup local dev uses SQLite. For production, use Postgres + pgvector:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/syncforge
DATABASE_URL=sqlite:///./syncforge.db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=syncforge
POSTGRES_PORT=5432

# =================================
# REDIS (Celery Queue)
# =================================
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# =================================
# AUTH.JS (NextAuth)
# =================================
AUTH_SECRET=your-super-secret-auth-key-change-this-in-prod
AUTH_URL=http://localhost:3000

# OAuth Providers
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# =================================
# GITHUB INTEGRATION
# =================================
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=your-personal-access-token-for-dev

# =================================
# LLM CONFIG (Ollama + OpenRouter)
# =================================
# Primary: Ollama (Free, Local). Install: https://ollama.com/download
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_CHAT_MODEL=llama3.1:8b
DEFAULT_SUMMARY_MODEL=llama3.1:8b
DEFAULT_FAST_MODEL=llama3.1:8b
EMBEDDING_MODEL=nomic-embed-text

# Offline extractive fallback when no LLM is reachable
ALLOW_EXTRACTIVE_FALLBACK=true

# Fallback: OpenRouter (Free tier available)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model Selection Strategy
ENABLE_MODEL_ROUTING=true
CODE_MODEL=qwen2.5-coder:7b
SUMMARY_MODEL=llama3.1:8b
AGENT_MODEL=deepseek-coder:6.7b

# =================================
# SPEECH TO TEXT (STT)
# =================================
# Option 1: faster-whisper (local, free)
STT_ENGINE=whisper_local
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Option 2: Groq Whisper (cloud, free tier)
# STT_ENGINE=groq_whisper
GROQ_API_KEY=gsk_your-groq-api-key
GROQ_WHISPER_MODEL=whisper-large-v3

# =================================
# VECTOR SEARCH (pgvector)
# =================================
VECTOR_DIMENSION=768
SIMILARITY_THRESHOLD=0.7

# =================================
# CODE EXECUTION SANDBOX
# =================================
# Option 1: Judge0 CE (self-hosted via Docker, free)
CODE_EXECUTOR=judge0
JUDGE0_BASE_URL=http://localhost:2358
JUDGE0_API_KEY=your-judge0-api-key

# Option 2: E2B (cloud, has free credits)
# CODE_EXECUTOR=e2b
E2B_API_KEY=e2b_your-e2b-api-key

# Execution Limits
EXEC_TIMEOUT_SECONDS=30
EXEC_MAX_MEMORY_MB=512
EXEC_MAX_CPU_PERCENT=50

# =================================
# FILE STORAGE
# =================================
# Option 1: Local Storage
STORAGE_TYPE=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=100

# Option 2: Supabase Storage
# STORAGE_TYPE=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=syncforge-files

# =================================
# DEV STUDIO (Phase 3)
# =================================
# Per-workspace sandbox for the AI Dev Studio. Each workspace gets its own
# directory under this root and can never read or write outside it.
DEVSTUDIO_ROOT=./devstudio
DEVSTUDIO_MAX_FILE_KB=512
DEVSTUDIO_MAX_FILES=2000
DEVSTUDIO_MAX_DEPTH=8
# Characters of the open file included as AI chat context.
DEVSTUDIO_CONTEXT_CHARS=12000

# =================================
# CELERY WORKER
# =================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_TIME_LIMIT=3600
CELERY_TASK_SOFT_TIME_LIMIT=3000

# =================================
# SECURITY & RATE LIMITING
# =================================
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_PER_MINUTE=60
MAX_TRANSCRIPT_CHARS=500000
REQUIRE_CONSENT_FOR_RECORDINGS=true

# =================================
# LOGGING & MONITORING
# =================================
LOG_LEVEL=info
ENABLE_DEBUG=false

# =================================
# DEVELOPMENT
# =================================
NEXT_TELEMETRY_DISABLED=1
PYTHONUNBUFFERED=1

{
  "name": "cognix-ai",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered workspace: Meetings → Decisions → Tasks → Code → Verification",
  "author": "Cognix",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -File scripts/start-all.ps1",
    "dev:all": "powershell -ExecutionPolicy Bypass -File scripts/start-all.ps1",
    "dev:all:stop": "powershell -ExecutionPolicy Bypass -File scripts/start-all.ps1 -Stop",
    "demo": "powershell -ExecutionPolicy Bypass -File scripts/demo.ps1",
    "demo:no-browser": "powershell -ExecutionPolicy Bypass -File scripts/demo.ps1 -NoBrowser",
    "setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-dev.ps1",
    "setup:dev": "powershell -ExecutionPolicy Bypass -File scripts/setup-dev.ps1",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,py,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,py,json}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "husky install || true",
    "dev:web": "cd apps/web && npm run dev",
    "dev:api": "cd apps/api && uvicorn main:app --reload --port 8000",
    "setup:ollama": "bash scripts/setup-ollama.sh",
    "setup:db": "bash scripts/setup-db.sh"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "next": "15.1.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,py,json,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.8.2"
}
